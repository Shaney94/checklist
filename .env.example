# Server only. Populate .env.local from the linked Vercel project; never commit values.
DESCOPE_PROJECT_ID=
NEXT_PUBLIC_DESCOPE_BASE_URL=https://api.descope.com
DESCOPE_MANAGEMENT_KEY=
TURNLI_TENANT_ID=
TURNLI_CONTENT_KEY=
TURNLI_ICAL_URL=
TURNLI_PROPERTY_NAME=
TURNLI_CHECKIN_TIME=15:00
TURNLI_CHECKOUT_TIME=10:00
# Provisioned through the connected Neon integration.
DATABASE_URL=
# Server-only bearer secret for scheduled background sync.
CRON_SECRET=

# Optional exact loopback origin for local custom ports or npm start; ignored on Vercel.
# npm run dev defaults to http://localhost:3000 and http://127.0.0.1:3000.
TURNLI_LOCAL_ORIGIN=
